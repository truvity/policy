{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/truvity/policy/schemas/service.json",
  "title": "service",
  "description": "The envelope every service's configuration carries. A service references this from its own schema with allOf, and adds its own properties beside it.",
  "type": "object",
  "properties": {
    "listen": { "$ref": "https://github.com/truvity/policy/schemas/fragments/listen.json" },
    "probes": { "$ref": "https://github.com/truvity/policy/schemas/fragments/probes.json" },
    "log": { "$ref": "https://github.com/truvity/policy/schemas/fragments/log.json" }
  },
  "required": ["probes"]
}
