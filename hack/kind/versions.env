# Everything the local cluster installs, pinned in one place.
#
# One file because "which version is the box on" must have an answer that is
# not a grep through three scripts, and because a dependency bot can propose
# a bump here and let the whole box prove it.

CLUSTER=policy

# The node image is pinned rather than left to the kind binary's default: a
# kind upgrade would otherwise move the Kubernetes version under the box, and
# a chart that stops rendering would look like the chart's fault.
NODE_IMAGE=kindest/node:v1.34.0

# Postgres, by digest — the same reasoning as the object store below: a tag
# can move under a cached pull and a supply-chain surprise should not arrive
# as an unrelated test failure. Plain server, no operator: this box proves
# what a chart RENDERS against Kubernetes' own admission, not a vendor's
# reconciler. Any chart here that describes an operator-managed database is
# proved at the level a renderer can reach, and no deeper.
POSTGRES_IMAGE=postgres:17@sha256:67f41722b7a8cbdb868a44a4995c846eddfdc2973bccb291ce937dce88ad5675

# NATS, with JetStream. No NACK: nothing here renders a Stream or Consumer
# custom resource any more, so there is no controller to prove one against.
NATS_CHART_VERSION=2.15.0

# S3, by digest. Deliberately not `latest` or `stable`: those resolve to a
# licensed build that exits without a token, which in a public repository
# would fail every fork's run with a licensing message its author cannot fix.
# The community edition is the 4.x line.
LOCALSTACK_IMAGE=localstack/localstack@sha256:3ebc37595918b8accb852f8048fef2aff047d465167edd655528065b07bc364a

# The local registry, kind's own documented recipe
# (https://kind.sigs.k8s.io/docs/user/local-registry/): a plain `registry:2`
# container, by digest, connected to the cluster's docker network so every
# node resolves `localhost:5001` to it.
REGISTRY_IMAGE=registry:2@sha256:a3d8aaa63ed8681a604f1dea0aa03f100d5895b6a58ace528858a7b332415373
REGISTRY_NAME=kind-registry
REGISTRY_PORT=5001

# A throwaway NATS CLI, for cluster-verify's round trip. It is not a server
# the box runs — it is a client `verify.sh` execs a Job with, the same way it
# execs into the Postgres and S3 pods rather than installing psql or awslocal
# on the host.
NATS_BOX_IMAGE=natsio/nats-box:0.18.0@sha256:abdc9f9f0120bb8adfbf674eb037d1551db55356eb198b7bd4ffed377f6950a6
