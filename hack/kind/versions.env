# Everything the local cluster installs, pinned in one place.
#
# One file because "which version of the operator is the box on" must have an
# answer that is not a grep through three scripts, and because a dependency
# bot can propose a bump here and let the whole box prove it.

CLUSTER=policy

# The node image is pinned rather than left to the kind binary's default: a
# kind upgrade would otherwise move the Kubernetes version under the box, and
# a chart that stops rendering would look like the chart's fault.
NODE_IMAGE=kindest/node:v1.34.0

# The CRDs a route needs to exist at all. Standard channel: the experimental
# one carries resources nothing here renders.
GATEWAY_API_VERSION=v1.6.2

# The PostgreSQL operator. The same one production runs — that is the whole
# point of a cluster rather than a container: a chart that renders a cluster
# resource is proved against the controller that will act on it.
CNPG_CHART_VERSION=0.29.0

# NATS, with JetStream, and the controller that turns stream resources into
# streams.
NATS_CHART_VERSION=2.15.0
NACK_CHART_VERSION=0.35.0

# S3, by digest. Deliberately not `latest` or `stable`: those resolve to a
# licensed build that exits without a token, which in a public repository
# would fail every fork's run with a licensing message its author cannot fix.
# The community edition is the 4.x line.
LOCALSTACK_IMAGE=localstack/localstack@sha256:3ebc37595918b8accb852f8048fef2aff047d465167edd655528065b07bc364a

# The certificate authority, and the thing that mounts an identity into a
# pod. Together they are what makes the transport rule provable here: the
# driver asks for a certificate using the POD'S OWN account token, and the
# approver refuses any request whose identity is not the one the requester
# holds. A workload is never asked what it is.
CERT_MANAGER_CHART_VERSION=v1.21.2
CSI_DRIVER_SPIFFE_CHART_VERSION=v0.15.0

# The trust domain this box issues under. A deployment names its cluster
# here; the box is not a cluster anyone deploys to, so it says so.
TRUST_DOMAIN=policy.local
