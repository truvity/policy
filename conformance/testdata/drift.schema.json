{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/drift.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["probes", "baseURL", "database"],
  "properties": {
    "probes": { "$ref": "https://github.com/truvity/policy/schemas/fragments/probes.json" },
    "baseURL": { "type": "string" },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string" },
        "passwordEnv": { "type": "string" },
        "maxConnections": { "type": "integer" }
      }
    }
  }
}
