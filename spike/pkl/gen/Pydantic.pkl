/// Python + pydantic (v2) from the intermediate form.
///
/// Prototype. Notable choices: strict mode (no "20" to 20, no 20.0 to 20),
/// `extra="forbid"`, and an explicit null refused so that an optional property
/// is absent rather than nullable, matching JSON Schema; defaults use `Field`.
module spike.gen.Pydantic

import "Model.pkl"

local function lit(v: Any): String =
  if (v is String) "\"\(v.replaceAll("\\", "\\\\").replaceAll("\"", "\\\""))\""
  else if (v is Boolean) (if (v) "True" else "False")
  else if (v is List) "[\(v.map((e) -> lit(e)).join(", "))]"
  else "\(v)"

local function rawStr(r: String): String = "r\"\(r.replaceAll("\"", "\\\""))\""

local function comment(d: String?, ind: String): String =
  if (d == null) "" else d.split("\n").map((l) -> "\(ind)#: \(l)\n").join("")

local function ann(n: Model.Node): String =
  if (n.kind == "object") "\"\(n.alias ?? n.cls.qname)\""
  else if (n.alias != null) n.alias
  else inner(n)

local function inner(n: Model.Node): String =
  if (n.kind == "string")
    if (n.length == null && n.pattern == null) "str"
    else "Annotated[str, StringConstraints(\(List(
      if (n.length?.min != null) "min_length=\(n.length.min)" else null,
      if (n.length?.max != null) "max_length=\(n.length.max)" else null,
      if (n.pattern != null) "pattern=\(rawStr(n.pattern.regex))" else null).filterNonNull().join(", ")))]"
  else if (n.kind == "integer" || n.kind == "number")
    let (base = if (n.kind == "integer") "int" else "float")
      if (n.range == null) base
      else "Annotated[\(base), Field(\(List(
        if (n.range.min != null) "ge=\(n.range.min)" else null,
        if (n.range.max != null) "le=\(n.range.max)" else null).filterNonNull().join(", ")))]"
  else if (n.kind == "boolean") "bool"
  else if (n.kind == "enum") "Literal[\(n.values.map((v) -> lit(v)).join(", "))]"
  else if (n.kind == "list") "list[\(ann(n.items))]"
  else if (n.kind == "map") "dict[\(ann(n.key)), \(ann(n.items))]"
  else if (n.kind == "open")
    if (n.requiresKeys == null) "dict[str, Any]"
    else "Annotated[dict[str, Any], AfterValidator(_has_keys(\(lit(n.requiresKeys.keys.toList()))))]"
  else if (n.kind == "union") n.members.map((m) -> ann(m)).join(" | ")
  else "Any"

local function field(p: Model.Prop): String =
  comment(p.doc, "    ") + "    \(p.name): \(ann(p.type))" +
  (if (p.hasDefault) " = Field(default=\(lit(p.default)))" else if (!p.required) " = None" else "") + "\n"

local function classDef(c: Model.Cls): String =
  "class \(c.qname)(\(if (c.base != null) c.base.cls.qname else "_Closed")):\n" +
  (if (c.doc != null) "    \"\"\"\(c.doc.replaceAll("\\", "\\\\").replaceAll("\"\"\"", "'''"))\"\"\"\n" else "") +
  (if (c.isOpen) "    model_config = ConfigDict(extra=\"allow\")\n" else if (c.base != null) "    model_config = ConfigDict(extra=\"forbid\")\n" else "") +
  (if (c.props.isEmpty) "    pass\n" else c.props.map((p) -> field(p)).join("")) + "\n\n"

local function classAliasDef(n: Model.Node): String =
  "class \(n.alias)(\(n.cls.qname)):\n" +
  (if (n.requiredWhen == null) "    pass\n"
   else "    @model_validator(mode=\"after\")\n    def _conditional(self) -> \"\(n.alias)\":\n" +
     "        if self.\(n.requiredWhen.property) in \(lit(n.requiredWhen.`in`.toList())):\n" +
     "            missing = [k for k in \(lit(n.requiredWhen.require.toList())) if getattr(self, k) is None]\n" +
     "            if missing:\n                raise ValueError(f\"{missing} required when \(n.requiredWhen.property) is \(n.requiredWhen.`in`.join(" or "))\")\n" +
     "        return self\n") + "\n\n"

local header = """
# Generated by spike/pkl from the Pkl contract. Do not edit.
from __future__ import annotations

from typing import Annotated, Any, Literal

from pydantic import AfterValidator, BaseModel, ConfigDict, Field, StringConstraints, model_validator


def _has_keys(keys: list[str]):
    def check(value: dict[str, Any]) -> dict[str, Any]:
        missing = [k for k in keys if k not in value]
        if missing:
            raise ValueError(f"missing {missing}")
        return value

    return check


class _Closed(BaseModel):
    model_config = ConfigDict(extra="forbid", strict=True)

    @model_validator(mode="before")
    @classmethod
    def _optional_is_absent_not_null(cls, data: Any) -> Any:
        if isinstance(data, dict):
            for key, value in data.items():
                if value is None:
                    raise ValueError(f"{key}: null is not a value; omit the key")
        return data


"""

function render(roots: Mapping<String, Model.Node>): String = let (ns = roots.toMap().values.toList())
  header +
  Model.aliases(ns).map((a) -> "\(a.alias) = \(inner(a))\n").join("") + "\n\n" +
  Model.classes(ns).map((c) -> classDef(c.cls)).join("") +
  Model.classAliases(ns).map((a) -> classAliasDef(a)).join("") +
  "SCHEMAS: dict[str, type[BaseModel]] = {\n" + roots.toMap().entries.map((e) -> "    \(lit(e.first)): \(e.second.alias ?? e.second.cls.qname),\n").join("") + "}\n"
