/// TypeScript + zod (v4) from the intermediate form.
///
/// Prototype. Notable choices: classes are strict objects (an unknown key is an
/// error, like a closed Pkl class); an optional property is absent, never
/// null (zod's `.optional()` already behaves so); object references are lazy so
/// declaration order does not matter; defaults use `.default()`.
module spike.gen.Zod

import "Model.pkl"

local const function esc(s: String): String = s.replaceAll("*/", "*\\/")
local function jsdoc(d: String?, ind: String): String =
  if (d == null) "" else "\(ind)/** \(esc(d.replaceAll("\n", " "))) */\n"

local function lit(v: Any): String =
  if (v is String) "\"\(v.replaceAll("\\", "\\\\").replaceAll("\"", "\\\""))\""
  else if (v is List) "[\(v.map((e) -> lit(e)).join(", "))]"
  else "\(v)"

local function regex(r: String): String = "/\(r.replaceAll("/", "\\/"))/"

/// The zod expression for a node, referring to aliases and classes by name.
local function expr(n: Model.Node): String =
  if (n.kind == "object") "z.lazy(() => \(n.alias ?? n.cls.qname))"
  else if (n.alias != null) n.alias
  else inner(n)

local function inner(n: Model.Node): String =
  if (n.kind == "string")
    "z.string()" + (if (n.length?.min != null) ".min(\(n.length.min))" else "") + (if (n.length?.max != null) ".max(\(n.length.max))" else "") +
    (if (n.pattern != null) ".regex(\(regex(n.pattern.regex)))" else "")
  else if (n.kind == "integer") "z.number().int()" + range(n)
  else if (n.kind == "number") "z.number()" + range(n)
  else if (n.kind == "boolean") "z.boolean()"
  else if (n.kind == "enum") "z.enum([\(n.values.map((v) -> lit(v)).join(", "))])"
  else if (n.kind == "list") "z.array(\(expr(n.items)))"
  else if (n.kind == "map") "z.record(\(expr(n.key)), \(expr(n.items)))"
  else if (n.kind == "open")
    "z.looseObject({})" + (if (n.requiresKeys == null) "" else ".refine((o) => [\(n.requiresKeys.keys.toList().map((k) -> lit(k)).join(", "))].every((k) => k in o))")
  else if (n.kind == "union") "z.union([\(n.members.map((m) -> expr(m)).join(", "))])"
  else "z.unknown()"

local function range(n: Model.Node): String =
  (if (n.range?.min != null) ".min(\(n.range.min))" else "") + (if (n.range?.max != null) ".max(\(n.range.max))" else "")

local function field(p: Model.Prop): String =
  jsdoc(p.doc, "  ") + "  \(p.name): \(expr(p.type))" +
  (if (p.hasDefault) ".default(\(lit(p.default)))" else if (!p.required) ".optional()" else "") + ",\n"

local function classDef(c: Model.Cls, refine: String): String =
  jsdoc(c.doc, "") +
  "export const \(c.qname)_shape = {\n" +
  (if (c.base != null) "  ...\(c.base.cls.qname)_shape,\n" else "") +
  c.props.map((p) -> field(p)).join("") + "};\n" +
  "export const \(c.qname) = z.\(if (c.isOpen) "looseObject" else "strictObject")(\(c.qname)_shape)\(refine);\n\n"

local function aliasDef(n: Model.Node): String =
  jsdoc(n.doc, "") + "export const \(n.alias) = \(inner(n));\n"

local function classAliasDef(n: Model.Node): String =
  "export const \(n.alias) = \(n.cls.qname)" +
  (if (n.requiredWhen == null) ""
   else ".refine((o) => !\(lit(n.requiredWhen.`in`.toList())).includes(o.\(n.requiredWhen.property)) || \(lit(n.requiredWhen.require.toList())).every((k) => (o as Record<string, unknown>)[k] !== undefined), { message: \"\(n.requiredWhen.require.join(", ")) required when \(n.requiredWhen.property) is \(n.requiredWhen.`in`.join(" or "))\" })") +
  ";\n\n"

/// The whole TypeScript module for the documents in `roots`.
function render(roots: Mapping<String, Model.Node>): String = let (ns = roots.toMap().values.toList())
  "// Generated by spike/pkl from the Pkl contract. Do not edit.\nimport { z } from \"zod\";\n\n" +
  Model.aliases(ns).map((a) -> aliasDef(a)).join("") + "\n" +
  Model.classes(ns).map((c) -> classDef(c.cls, "")).join("") +
  Model.classAliases(ns).map((a) -> classAliasDef(a)).join("") +
  "export const schemas = {\n" + roots.toMap().entries.map((e) -> "  \(lit(e.first)): \(if (e.second.alias != null) e.second.alias else e.second.cls.qname),\n").join("") + "} as const;\n"
